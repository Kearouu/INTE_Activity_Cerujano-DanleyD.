}\
.ace-jdoodle-dark .ace_support.ace_function,\
.ace-jdoodle-dark .ace_support.ace_class,\
.ace-jdoodle-dark .ace_entity.ace_name.ace_function,\
.ace-jdoodle-dark .ace_entity.ace_name.ace_tag {\
color: #60a5fa\
}\
.ace-jdoodle-dark .ace_variable,\
.ace-jdoodle-dark .ace_variable.ace_parameter,\
.ace-jdoodle-dark .ace_identifier,\
.ace-jdoodle-dark .ace_entity.ace_other.ace_attribute-name {\
