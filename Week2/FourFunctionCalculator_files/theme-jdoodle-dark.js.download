}\
.ace-jdoodle-dark .ace_string {\
color: #34d399\
}\
.ace-jdoodle-dark .ace_string.ace_regexp {\
color: #34d399\
}\
.ace-jdoodle-dark .ace_comment {\
font-style: italic;\
color: #7280b4\
}\
.ace-jdoodle-dark .ace_heading,\
.ace-jdoodle-dark .ace_markup.ace_heading {\
color: #34d399\
}\
.ace-jdoodle-dark .ace_indent-guide {\
background: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAACCAYAAACZgbYnAAAAE0lEQVQImWNgYGBgYHB3d/8PAAOIAdULw8qMAAAAAElFTkSuQmCC) right repeat-y\
}";
  var dom = require("ace/lib/dom");
  dom.importCssString(exports.cssText, exports.cssClass, false);
});
