    }

    .divider {
      width: 1px;
      height: 25px; 
      background-color: #5F7394;
      margin: 0 10px; 
    }

    .links {
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 15px;
      margin: 10px 0px;
    }

    .links a {
      color: #5F7394; 
      text-decoration: underline; 
      margin: 0 10px; 
    }

    .counter-container {
      margin-top: 20px;
    }

    .counter-button {
      font-size: 18px;
      padding: 10px 20px;
      background-color: #5F7394;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .counter-button:hover {
      background-color: #2A4D77;
